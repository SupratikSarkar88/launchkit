# Copy to .env (never commit it). One set of keys serves every product.

# Cloudflare: dash > My Profile > API Tokens > Create custom token
#   Account: Registrar  -> Edit        (buy domains)
#   Zone:    Zone       -> Read, DNS -> Edit   (All zones in the account)
# Account prerequisites for API purchase: default payment method, default registrant contact,
# Domain Registration Agreement accepted (all in the Registrar section of the dashboard).
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Vercel: Account Settings > Tokens. Team ID only if projects live under a team.
# The Vercel GitHub app must have access to your repos (install once, "All repositories").
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Google Cloud project (one, reused): enable "Google Site Verification API", "Google Search Console API",
# "Google Analytics Admin API". OAuth consent screen: External, then PUBLISH to "In production"
# (in "Testing" the refresh token dies after 7 days). Credentials > OAuth client ID > Desktop app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=        # filled by: python3 google_auth_setup.py

# GA4: analytics.google.com > Admin > Account settings > Account ID (numbers only)
GA4_ACCOUNT_ID=

# Optional: any 32-char hex string. Serve it as public/<key>.txt in each repo to enable Bing/IndexNow pings.
INDEXNOW_KEY=

# Optional PostHog (product analytics / session replay), used with --posthog or --posthog-new.
# Free PostHog orgs get ONE project: use --posthog with that project's key and split products by $host.
POSTHOG_HOST=https://us.i.posthog.com      # EU: https://eu.i.posthog.com
POSTHOG_PROJECT_KEY=                       # Project settings > Project API key (phc_...)
# Only for --posthog-new (paid org): Personal API key with project:write scope, and your organization ID
POSTHOG_PERSONAL_API_KEY=
POSTHOG_ORG_ID=
